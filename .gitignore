# Claude Code agent scratch directory — worktrees, logs, settings.
# Per-machine state that should never be tracked.
.claude/

# Python bytecode cache (e.g., from migration_doc/_regen_wgsl_js.py).
__pycache__/
*.pyc

# Playwright MCP runtime artifacts (console logs, page snapshots, screenshots
# captured by automation runs — not source).
/.playwright-mcp/

# Loose debug screenshots dropped at the repo root by ad-hoc bug-hunt
# sessions. The Tools/visual-regression scaffold is the proper place
# for any image we want to check in.
/bug*-test.*
/split-screen-*.png
/test-bug*.png
/verified-*.png
/*.jpeg

# Ad-hoc debug scratch dir. Contains decoded worker bundles and other
# throwaway test scripts — do not commit.
/tmp/

# Agent/worker landing scratch dir (added 2026-08-14, fix SOL-12). Holds exported
# landing patches, per-run server stdout/stderr logs, and landing-audit working
# directories. Every file in it is reproducible from git or from a re-run, and the
# patches duplicate commits that are already on main — committing them would bank
# a second, drifting copy of landed work. It was left untracked and unignored for
# the whole 2026-08-11..14 range, so it showed up as noise in every `git status`
# a successor ran; that is what this rule removes.
/.tmp/

# Visual regression sweep output. Every PNG under
# `Tools/visual-regression/output/` is regenerated by a probe script on
# each invocation, so committing them just churns the repo with binary
# blobs. The reference baselines that ARE worth checking in live under
# `Tools/visual-regression/baseline/` and are NOT covered by this rule.
/Tools/visual-regression/output/

# README screenshot harness reports; the PNGs it captures are committed
# under Documentation/Images/webgpu-fork/, the run reports are not.
/Tools/readme-screenshots/output/
/_review/

# Codex seat scratch: Rust build targets and evidence staging written into the
# repo tree during the 2026-08-30/31 process-supervisor lanes (926 MB, 4,577
# files at the 2026-09-01 audit). Never landable; a directory-level `git add`
# would sweep it without this rule.
/.codex-tmp/

# Chromium's crash-handler log, written to the current directory whenever Edge
# is launched from the repo root (Playwright probes, the built-in browser).
/debug.log
