# Used in the CLA checking GitHub workflow
GoogleConfig.json

# Claude Code agent scratch directory — worktrees, logs, settings.
# Per-machine state that should never be tracked.
.claude/

# Python bytecode cache (e.g., from migration_doc/_regen_wgsl_js.py).
__pycache__/
*.pyc

# Playwright MCP runtime artifacts (console logs, page snapshots, screenshots
# captured by automation runs — not source).
/.playwright-mcp/

# Loose debug screenshots dropped at the repo root by ad-hoc bug-hunt
# sessions. The Tools/visual-regression scaffold is the proper place
# for any image we want to check in.
/bug*-test.*
/split-screen-*.png
/test-bug*.png
/verified-*.png
/*.jpeg

# Ad-hoc debug scratch dir. Contains decoded worker bundles and other
# throwaway test scripts — do not commit.
/tmp/

# Cross-backend visual regression sweep output. The runner regenerates
# every PNG + the report.json on each invocation, so committing them just
# churns the repo with binary blobs. The runner now also wipes this
# directory at the start of every sweep so we always start from a clean
# slate (avoids stale screenshots from older runs masking new fixes).
/Tools/visual-regression/output/cross-backend/

