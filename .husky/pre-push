#!/usr/bin/env sh

# Landing-compliance guard — ruling R-2026-08-14-4.
#
# Enforces EXECUTOR_LANE_CHARTER_2026-08-14.md §2.1/§2.2 mechanically: batch
# prefix + monotonicity, non-empty body, Co-Authored-By trailer, and the
# weekday 07:00-19:00 US Eastern quiet-hours window — and refuses deleting or
# force-rewriting main on the remote (other refs stay free for safety-branch
# housekeeping). Rules live in
# Tools/landing-rules.mjs; Tools/pre-push-guard.mjs is the git-aware driver
# and reads git's ref lines from this hook's stdin.
#
# git runs pre-push for `git push` only — never for fetch, pull, or clone.
#
# HOOK_EXPLAIN=1 git push ...   prints a rule-by-rule verdict per commit.
#
# There is no bypass flag here on purpose. `git push --no-verify` still skips
# the hook. `npm run verify-landing` can detect skipped commit-message and
# timestamp rules in a selected range, but it cannot reconstruct a bypassed
# deletion or rewrite; server-side branch protection is a separate control.
# (The driver also accepts a 5th argv entry that pins the quiet-hours clock —
# it exists for direct-invocation tests; git's two-argument hook contract
# means "$@" above never supplies it, so it is unreachable from a real push.)
#
# POSIX sh only (Windows git ships a minimal sh): no arrays, no [[ ]], no
# `local`, no process substitution.

# Hooks resolve through core.hooksPath, so $0 points into the main checkout's
# .husky/ even when the push comes from a linked worktree. Canonicalize that
# location and require the driver beside the hook; never fall back to a
# working-directory-relative script.
hook_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd -P)
if [ -z "$hook_dir" ]; then
  echo "landing-guard: cannot resolve the hook directory; push refused" >&2
  exit 2
fi
hook_root=$(dirname "$hook_dir")
guard="$hook_root/Tools/pre-push-guard.mjs"
if [ ! -f "$guard" ] || [ ! -r "$guard" ]; then
  echo "landing-guard: trusted driver is missing or unreadable: $guard" >&2
  exit 2
fi

node "$guard" "$@"
