{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./baseline-manifest.schema.json",
  "title": "Cesium fork visual baseline provenance manifest",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "scene",
        "renderer",
        "provenanceClass",
        "image",
        "imageSha256",
        "width",
        "height",
        "sourceCommit",
        "sourceDirty",
        "sceneIdentity",
        "browserClass",
        "browserVersion",
        "adapterClass",
        "capturedAt",
        "review"
      ],
      "properties": {
        "scene": { "type": "string", "minLength": 1 },
        "renderer": { "enum": ["webgl", "webgpu"] },
        "provenanceClass": {
          "enum": [
            "accepted-current",
            "characterization",
            "experimental",
            "reverted-or-unknown"
          ]
        },
        "image": { "type": "string", "pattern": "\\.png$" },
        "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceDirty": { "const": false },
        "sceneIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "browserClass": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "adapterClass": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "review": {
          "type": "object",
          "required": ["status", "reviewedBy", "rationale", "reviewedAt"],
          "properties": {
            "status": { "const": "approved" },
            "reviewedBy": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
